    <rect x="10" y="30" width="104" height="70" rx="11" fill="#111822" stroke="#FFB800" stroke-width="1.3" class="shimmer"/>
    <text x="62" y="67" text-anchor="middle" font-size="26">🇮🇳</text>
    <text x="62" y="82" text-anchor="middle" font-family="'Segoe UI',sans-serif" font-weight="700" font-size="10" fill="#E8EBF0">India</text>
    <text x="62" y="94" text-anchor="middle" font-family="monospace" font-size="8" fill="#5A6688">₹ MV Act 2019</text>

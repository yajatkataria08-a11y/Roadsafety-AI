<svg width="820" height="110" viewBox="0 0 820 110" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <style>
      .n1 { animation: cardPop 0.4s 0.05s ease both; }
      .n2 { animation: cardPop 0.4s 0.12s ease both; }
      .n3 { animation: cardPop 0.4s 0.19s ease both; }
      .n4 { animation: cardPop 0.4s 0.26s ease both; }
      .n5 { animation: cardPop 0.4s 0.33s ease both; }
      .n6 { animation: cardPop 0.4s 0.40s ease both; }
      .n7 { animation: cardPop 0.4s 0.47s ease both; }
      @keyframes cardPop {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .shimmer { animation: shimmer 2.5s ease-in-out infinite; }
      @keyframes shimmer {
        0%,100% { stroke-opacity: 0.35; }
        50%     { stroke-opacity: 0.8; }
      }
    </style>
  </defs>

  <rect width="820" height="110" rx="14" fill="#0D1018"/>
  <!-- title -->
  <text x="410" y="22" text-anchor="middle"
        font-family="'Segoe UI',sans-serif" font-weight="700" font-size="11"

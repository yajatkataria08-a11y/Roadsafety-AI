# ── Database ───────────────────────────────────────────────────────────────────
USE_SQLITE=true           # Set false for PostgreSQL
DB_USER=postgres
DB_PASS=password
DB_HOST=localhost
DB_NAME=roadsafety

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * only for local development.
ALLOWED_ORIGINS=http://localhost:3000

# ── SMS / WhatsApp via Twilio ──────────────────────────────────────────────────
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=AC03c5a0ddaf26a5c8a47a04c35531a53e
TWILIO_AUTH_TOKEN=0897d8fc8f59bd05d599594d592b4f8a
TWILIO_FROM_NUMBER=+13529663897     # Your Twilio phone number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio sandbox or approved sender

# ── Authority notification recipients ─────────────────────────────────────────
# Comma-separated phone numbers / emails.  Leave blank to disable that channel.
NOTIFY_POLICE_NUMBERS=+919XXXXXXXXX,+919XXXXXXXXX
NOTIFY_AMBULANCE_NUMBERS=+919XXXXXXXXX
NOTIFY_FIRE_NUMBERS=+919XXXXXXXXX
NOTIFY_WHATSAPP_NUMBERS=+919XXXXXXXXX,+919XXXXXXXXX
NOTIFY_EMAIL_RECIPIENTS=control.room@police.gov.in,ambulance@health.gov.in

# ── Webhook (any HTTP endpoint) ────────────────────────────────────────────────
# POST JSON payload with incident details to this URL on every Crash Mode trigger
NOTIFY_WEBHOOK_URL=https://your-control-room.example.com/api/emergency

# ── SMTP Email ─────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=roadsafetyai@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=RoadSafetyAI <roadsafetyai@gmail.com>

# ════════════════════════════════════════════════════════════════════════════════
# LLM REASONING LAYER  (v5 — add these for AI-powered hybrid routing)
# ════════════════════════════════════════════════════════════════════════════════

# ── PRIMARY LLM: Google Gemini Flash ──────────────────────────────────────────
# Get your key free at: https://aistudio.google.com/app/apikey
# Pricing: ~$0.075/1M input tokens, $0.30/1M output tokens (very cheap)
# Gemini Flash is the recommended primary LLM — fast, cheap, JSON mode support.
GEMINI_API_KEY=AIzaSyCNbti6aYifVwrB5umbBp74rPKc5rk9N9o

# ── FALLBACK LLM: Groq (Llama-3.1-70B) ───────────────────────────────────────
# Get your key free at: https://console.groq.com/keys
# Free tier: 6000 requests/day, 30 requests/minute
# Used automatically when Gemini fails or rate-limits
GROQ_API_KEY=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

# ── LLM Routing Thresholds ────────────────────────────────────────────────────
# Queries with rule-based confidence BELOW this value will be sent to LLM.
# Range: 0.0 - 1.0 | Default: 0.65 | Lower = more LLM calls = more cost
LLM_CONFIDENCE_THRESHOLD=0.65

# ── Cache Settings ────────────────────────────────────────────────────────────
# In-memory LRU cache for repeated LLM queries
# CACHE_MAX_SIZE: max entries before LRU eviction  (default: 512)
# CACHE_TTL_SECS: time-to-live per entry in seconds (default: 1800 = 30 min)
CACHE_MAX_SIZE=512
CACHE_TTL_SECS=1800

# ── Optional: Redis for persistent caching across restarts ────────────────────
# Leave blank to use in-memory cache only (fine for hackathon demo)
# Format: redis://localhost:6379/0
REDIS_URL=

# ── Session Management ────────────────────────────────────────────────────────
# How long to keep conversation history per session (seconds)
# After this idle period, history is cleared (new conversation starts)
SESSION_TTL_SECS=1800

# ── Cost Controls ─────────────────────────────────────────────────────────────
# Maximum LLM calls per minute across all users (0 = unlimited)
# Set this to protect against runaway costs during demo
LLM_RATE_LIMIT_PER_MINUTE=60

# ── MSG91 (SMS + Email OTP) ───────────────────────────────────────────────────
MSG91_AUTH_KEY=511284AYaEUIni7HSW6a0f22e6P1        # MSG91 Dashboard → API Keys
MSG91_TEMPLATE_ID=6a0f2590ab683972f50fe8a2    # MSG91 Dashboard → OTP → Templates
MSG91_SENDER_ID=RDSAFE                          # 6 char sender ID (customize)

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@roadsafety.ai

# ── OTP Settings ─────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
